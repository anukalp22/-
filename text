function getRecentTestHistory(currentAge) {
    try {
        const history = JSON.parse(safeStorage.getItem("baby_play_test_history") || "{}");
        return history[currentAge] || [];
    } catch(e) {
        return [];
    }
}

function recordTestResult(currentAge, currentScore) {
    try {
        const history = JSON.parse(safeStorage.getItem("baby_play_test_history") || "{}");
        if (!history[currentAge]) {
            history[currentAge] = [];
        }
        history[currentAge].push(currentScore);
        if (history[currentAge].length > 10) {
            history[currentAge].shift();
        }
        safeStorage.setItem("baby_play_test_history", JSON.stringify(history));
        return history[currentAge];
    } catch(e) {
        return [];
    }
}

function checkLevelUpEligibility(currentAge) {
    const recentScores = getRecentTestHistory(currentAge);
    if (recentScores.length < 10) return false;
    
    let perfectOrGreatCount = 0;
    for (let s of recentScores) {
        if (s >= 80) {
            perfectOrGreatCount++;
        }
    }
    return perfectOrGreatCount >= 8;
}

function getAudioContext(){
    if(!audioContext){
        audioContext = new (window.AudioContext || window.webkitAudioContext)();
    }
    if(audioContext.state === "suspended"){
        audioContext.resume();
    }
    return audioContext;
}

function tone(frequency, start, duration, type="sine", volume=.2){
    try {
        const ctx = getAudioContext();
        const oscillator = ctx.createOscillator();
        const gain = ctx.createGain();
        oscillator.type = type;
        oscillator.frequency.setValueAtTime(frequency, start);
        gain.gain.setValueAtTime(.0001, start);
        gain.gain.exponentialRampToValueAtTime(volume, start + .03);
        gain.gain.exponentialRampToValueAtTime(.0001, start + duration);
        oscillator.connect(gain);
        gain.connect(ctx.destination);
        oscillator.start(start);
        oscillator.stop(start + duration + .05);
    } catch(e) {}
}

function soundTap(){
    const ctx = getAudioContext();
    tone(620, ctx.currentTime, .08, "sine", .12);
}

function soundCorrect(){
    const ctx = getAudioContext();
    const now = ctx.currentTime;
    tone(523.25, now,       .15, "triangle", .25);
    tone(659.25, now + .10, .15, "triangle", .25);
    tone(783.99, now + .20, .15, "triangle", .25);
    tone(1046.50, now + .30, .35, "triangle", .30);
}

function soundWrong(){
    const ctx = getAudioContext();
    const now = ctx.currentTime;
    tone(160, now,       .18, "sawtooth", .18);
    tone(120, now + .12, .25, "sawtooth", .18);
}

function soundFinish(){
    const ctx = getAudioContext();
    const now = ctx.currentTime;
    const notes = [440, 554.37, 659.25, 880, 1108.73, 1318.51];
    notes.forEach((freq, index) => {
        tone(freq, now + (index * 0.08), 0.2, "triangle", 0.25);
    });
}

