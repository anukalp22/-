    setItem: function(key, value) {
        try {
            localStorage.setItem(key, value);
        } catch (e) {
            memoryFallback[key] = value;
        }
    },
    getItem: function(key) {
        try {
            return localStorage.getItem(key) || memoryFallback[key] || null;
        } catch (e) {
            return memoryFallback[key] || null;
        }
    }
};

