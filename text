function checkAnswer(selected){
    if(answerLocked) return;
    const q = worksheetQuestions[currentIndex];
    if(!q) return;
    answerLocked=true;

    const targetVal = String(q.target);
    const correct = String(selected) === targetVal;
    const buttons = [...document.querySelectorAll(".answer-option")];
    buttons.forEach(button=> button.disabled=true);

    const chosen = buttons.find(button=> String(button.dataset.answer) === String(selected));
    const correctButton = buttons.find(button=> String(button.dataset.answer) === targetVal);

    if(correct){
        score = Math.min(100, Math.round(score + (100 / worksheetQuestions.length)));
        if(chosen) chosen.classList.add("answer-correct");
        soundCorrect();
        createConfetti(innerWidth/2, innerHeight/2);
    }else{
        wrongAnswers++;
        if(chosen) chosen.classList.add("answer-wrong");
        if(correctButton) correctButton.classList.add("answer-correct");
        soundWrong();
    }

    document.getElementById("score").textContent=score;

    setTimeout(()=>{
        currentIndex++;
        answerLocked=false;
        if(currentIndex >= worksheetQuestions.length){
            finishTest();
        }else{
            renderWorksheet();
        }
    }, correct ? 900 : 1500);
}

function finishTest(){
    soundFinish();
    
    recordTestResult(age, score);
    saveHistory();
    
    const canLevelUp = checkLevelUpEligibility(age);
    let levelUpMessage = "";

    if (canLevelUp && age < 10) {
        age += 1;
        try {
            const history = JSON.parse(safeStorage.getItem("baby_play_test_history") || "{}");
            history[age - 1] = [];
            safeStorage.setItem("baby_play_test_history", JSON.stringify(history));
        } catch(e) {}

        levelUpMessage = `<div class="bg-green-100 text-green-800 font-bold p-3 rounded-2xl mb-3 text-sm">🎉 शानदार! आपने लगातार अच्छा प्रदर्शन किया है, अब आप ${getClassName(age)} पर पहुँच गए हैं! 🚀</div>`;
    } else {
        const historyCount = getRecentTestHistory(age).length;
        levelUpMessage = `<div class="text-xs font-bold text-blue-600 mb-3">⭐ टेस्ट पूरा हुआ! कुल टेस्ट रिकॉर्ड: ${historyCount}/10</div>`;
    }

    let starDisplay = "⭐";
    if (score >= 80) {
        starDisplay = "⭐⭐⭐";
    } else if (score >= 50) {
        starDisplay = "⭐⭐";
    } else {
        starDisplay = "⭐";
    }

    const content = document.getElementById("content");

    content.innerHTML=`
        <div class="kids-card w-full max-w-md p-6 text-center">
            <div class="text-5xl mb-2">${score>=80?"🏆":"🌟"}</div>
            <div class="text-3xl font-black text-amber-500 mb-2">${starDisplay}</div>
            <h2 class="app-title text-3xl" style="color:#4f8cff">${score>=80?"बहुत बढ़िया!":"अच्छा प्रयास!"}</h2>
            <div class="text-5xl font-black mt-3">${score}</div>
            <p class="text-gray-500 text-sm mt-1 mb-3">स्कोर</p>
            ${levelUpMessage}
            <button onclick="soundTap(); backToMenu();" class="w-full py-3.5 rounded-2xl text-white font-black text-lg shadow-md" style="background:linear-gradient(145deg,#35c98a,#20a56a);">
                ओके (OK) 👍
            </button>
        </div>
    `;

    document.getElementById("score-badge").classList.add("hidden");
    document.getElementById("progress").innerHTML="";
}

function saveHistory(){
    try{
        const key="baby_play_history_v5";
        const history=JSON.parse(safeStorage.getItem(key)||"[]");
        history.push({age, className: getClassName(age), mode:currentMode, score, wrong:wrongAnswers, date:new Date().toLocaleString()});
        if(history.length>20) history.shift();
        safeStorage.setItem(key, JSON.stringify(history));
    }catch(error){}
}

function openParentDashboard(){
    soundTap();
    document.getElementById("parent-screen").classList.remove("hidden");
    renderHistory();
}

function closeParentDashboard(){
    soundTap();
    document.getElementById("parent-screen").classList.add("hidden");
}

function renderHistory(){
    const container=document.getElementById("history");
    let history=[];
    try{
        history=JSON.parse(safeStorage.getItem("baby_play_history_v5")||"[]");
    }catch(error){}

    if(!history.length){
        container.innerHTML=`<div class="text-center text-gray-400 p-5 text-sm">अभी तक कोई टेस्ट पूरा नहीं हुआ है।</div>`;
        return;
