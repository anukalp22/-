function updateProgress(){
    const progress = document.getElementById("progress");
    progress.innerHTML="";
    const total = worksheetQuestions.length > 0 ? worksheetQuestions.length : Math.min(currentLearningList.length, 10);
    const active = worksheetQuestions.length > 0 ? currentIndex : Math.floor((currentIndex / currentLearningList.length) * total);

    for(let i=0; i<total; i++){
        const dot = document.createElement("div");
        dot.className="progress-dot";
        if(i===active) dot.classList.add("active");
        progress.appendChild(dot);
    }
}

