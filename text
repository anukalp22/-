:root{
    --blue:#4f8cff;
    --purple:#765cff;
    --pink:#ff6fae;
    --green:#35c98a;
    --red:#ff6673;
    --yellow:#ffd85a;
    --ink:#253653;
}

*{
    box-sizing:border-box;
}

html,
body{
    width:100%;
    height:100%;
    margin:0;
}

body{
    font-family:'Quicksand',sans-serif;
    background:
        radial-gradient(circle at 8% 8%,#fff 0 5%,transparent 18%),
        radial-gradient(circle at 92% 12%,#fff7b8 0 4%,transparent 17%),
        radial-gradient(circle at 88% 90%,#d9f7ff 0 6%,transparent 20%),
        linear-gradient(
            145deg,
            #bcecff 0%,
            #d9d2ff 52%,
            #ffd7ed 100%
        );
    color:var(--ink);
    overflow:hidden;
    user-select:none;
    -webkit-user-select:none;
    touch-action:manipulation;
}

button{
    font-family:inherit;
    cursor:pointer;
    -webkit-tap-highlight-color:transparent;
}

.hidden{
    display:none!important;
}

.app-title{
    font-family:'Fredoka',sans-serif;
    font-weight:700;
}

.kids-card{
    background:#fff;
    border:3px solid #e9eef8;
    border-radius:28px;
    box-shadow:0 10px 0 #dce5f2;
}

.answer-option{
    min-height:80px;
    border:3px solid #e7edfa;
    border-radius:24px;
    background:linear-gradient(180deg,#fff,#f8fbff);
    box-shadow:0 7px 0 #dbe4f3;
    font-size:1.5rem;
    font-weight:900;
    transition:.18s;
}

.answer-option:active{
    transform:translateY(5px);
    box-shadow:0 2px 0 #dbe4f3;
}

.answer-correct{
    border-color:#28bd79!important;
    background:#dcfce9!important;
    box-shadow:0 6px 0 #20a56a!important;
}

.answer-wrong{
    border-color:#ff5968!important;
    background:#ffe0e4!important;
    box-shadow:0 6px 0 #d94352!important;
    animation:shake .28s ease;
}

@keyframes shake{
    25%{transform:translateX(-7px)}
    50%{transform:translateX(7px)}
    75%{transform:translateX(-4px)}
}

.bounce{
    animation:bounce 2s infinite;
}

@keyframes bounce{
    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-12px);
    }
}

.pop{
    animation:pop .25s ease;
}

@keyframes pop{
    0%{
        transform:scale(.8);
        opacity:.5;
    }

    100%{
        transform:scale(1);
        opacity:1;
    }
}

.progress-dot{
    width:8px;
    height:8px;
    border-radius:50%;
    background:#dbe4f3;
}

.progress-dot.active{
    width:12px;
    height:12px;
    background:var(--blue);
}

.confetti{
    position:fixed;
    width:10px;
    height:10px;
    border-radius:50%;
    pointer-events:none;
    z-index:999;
}

.mode-card{
    min-height:85px;
    border:4px solid white;
    border-radius:22px;
    background:white;
    color:#26364f;
    box-shadow:0 7px 0 #263f7a20;
    transition:.2s;
    position:relative;
    overflow:hidden;
}

.mode-card:active{
    transform:translateY(4px);
    box-shadow:0 3px 0 #263f7a20;
}

.age-button{
    height:54px;
    border:3px solid #eaf0ff;
    background:#f8faff;
    color:#334155;
    border-radius:18px;
    font-size:15px;
    font-weight:900;
}

.age-button.selected{
    background:linear-gradient(
        145deg,
        #4f8cff,
        #765cff
    );
    color:white;
    border-color:white;
    box-shadow:0 6px 0 #365fc0;
}

.nav-button{
    width:64px;
    height:64px;
    border-radius:50%;
    border:4px solid #e6eefb;
    background:white;
    color:#4f8cff;
    font-size:25px;
    box-shadow:0 7px 15px #29456b18;
}

.nav-button:active{
    transform:scale(.9);
}

.learning-number{
    font-family:'Fredoka',sans-serif;
    font-size:7rem;
    line-height:1;
    font-weight:700;
}

.learning-letter{
    font-family:'Fredoka',sans-serif;
    font-size:5rem;
    line-height:1.2;
    font-weight:700;
}

.star-grid{
    display:grid;
    gap:7px;
    justify-items:center;
    align-items:center;
    width:100%;
}

.math-box{
    background:white;
    border:3px solid #edf1f8;
    border-radius:24px;
    padding:15px;
    min-width:100px;
    min-height:95px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
}

@media(max-width:420px){
