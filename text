// 2 से 5 तक के पूरे पहाड़े (4th Class)
const tables2to5List = [];
for(let t=2; t<=5; t++){
    let fullTableStr = "";
    for(let i=1; i<=10; i++){
        fullTableStr += `${t} × ${i} = ${t * i}<br>`;
    }
    tables2to5List.push({
        tableNum: t,
        l: `${t} का पहाड़ा (Table of ${t})`,
        contentStr: fullTableStr,
        e: t === 2 ? "🦆" : t === 3 ? "⭐" : t === 4 ? "🎈" : "🍎",
        c: t === 2 ? "#3b82f6" : t === 3 ? "#10b981" : t === 4 ? "#f59e0b" : "#ef4444"
    });
}

const tableQuizList = [];
