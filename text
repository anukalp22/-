            });
        }else if(mode==="ws3"){
            const n1 = Math.floor(Math.random()*6)+1;
            const n2 = Math.floor(Math.random()*6)+1;
            const target = n1+n2;
            worksheetQuestions.push({n1, n2, target, options:makeOptions(target,1,12)});
        }else if(mode==="missingword"){
            const qData = sampleWords[Math.floor(Math.random() * sampleWords.length)];
            worksheetQuestions.push({
                isMissingWord: true,
                word: qData.word,
                emoji: qData.emoji,
                missingIndex: qData.missingIndex,
                target: qData.target,
                options: [...qData.options].sort(() => Math.random() - 0.5)
            });
        }else if(mode==="sentencefill"){
            const sData = sentenceFillList[Math.floor(Math.random() * sentenceFillList.length)];
            worksheetQuestions.push({
                isSentenceFill: true,
                sentence: sData.sentence,
                emoji: sData.emoji,
                target: sData.target,
                options: [...sData.options].sort(() => Math.random() - 0.5)
            });
        }else if(mode==="greaterlessquiz"){
            const n1 = Math.floor(Math.random()*15)+1;
            let n2 = Math.floor(Math.random()*15)+1;
            while(n1 === n2) n2 = Math.floor(Math.random()*15)+1;
            const target = n1 > n2 ? ">" : "<";
            worksheetQuestions.push({
                isGreaterLess: true,
                n1: n1,
                n2: n2,
                target: target,
                options: [">", "<", "="].sort(() => Math.random() - 0.5)
            });
        }else if(mode==="ws4"){
            const sample = alphabet[Math.floor(Math.random()*alphabet.length)];
            const target = sample.l;
            const targetEmoji = sample.e;
            worksheetQuestions.push({target, targetEmoji, options:makeOptionsString(target, alphabet.map(a=>a.l))});
        }else if(mode==="addition"){
            const a = Math.floor(Math.random()*10)+1;
            const b = Math.floor(Math.random()*10)+1;
            const target=a+b;
            worksheetQuestions.push({a, b, target, options:makeOptions(target,2,20)});
        }else if(mode==="addition2"){
            const a = Math.floor(Math.random()*50)+10;
            const b = Math.floor(Math.random()*40)+10;
            const target=a+b;
            worksheetQuestions.push({a, b, target, options:makeOptions(target,10,100)});
        }else if(mode==="subtraction"){
            const a = Math.floor(Math.random()*50)+20;
            const b = Math.floor(Math.random()*20)+1;
            const target=a-b;
            worksheetQuestions.push({a, b, target, options:makeOptions(target,1,70)});
        }else if(mode==="multiplication"){
            const a = Math.floor(Math.random()*10)+1;
            const b = Math.floor(Math.random()*10)+1;
            const target=a*b;
            worksheetQuestions.push({a, b, target, options:makeOptions(target,1,100)});
        }else if(mode==="tables" || mode==="tables20"){
            const limit = mode==="tables" ? 10 : 20;
            const a = Math.floor(Math.random()*limit)+2;
            const b = Math.floor(Math.random()*10)+1;
            const target = a*b;
            worksheetQuestions.push({a, b, target, options:makeOptions(target, 2, limit*10)});
        }else if(mode==="wordmath"){
            const apples = Math.floor(Math.random()*8)+2;
            const more = Math.floor(Math.random()*6)+1;
            const target = apples + more;
            worksheetQuestions.push({word:`Rahul has ${apples} apples. He gets ${more} more. How many apples does have now?`, target, options:makeOptions(target, 2, 20)});
        }else{
            const target = Math.floor(Math.random()*15)+1;
            worksheetQuestions.push({target, options:makeOptions(target,1,20)});
        }
    }
    worksheetQuestions.sort(() => Math.random() - 0.5);
    renderWorksheet();
}

function makeOptions(target, min, max){
    const options=[target];
    while(options.length<3){
        const value = Math.floor(Math.random()*(max-min+1))+min;
        if(!options.includes(value)) options.push(value);
    }
    return options.sort(()=>Math.random()-.5);
}

function makeOptionsString(target, pool){
    const options=[target];
    while(options.length<3){
        const rand = pool[Math.floor(Math.random()*pool.length)];
        if(!options.includes(rand)) options.push(rand);
    }
    return options.sort(()=>Math.random()-.5);
}

